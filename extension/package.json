{
  "name": "sino-gear-crm-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Sino Gear CRM Chrome extension — WhatsApp Web overlay + Supabase backend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:gpt-paragraphs": "node --test scripts/test-gpt-paragraphs.mjs",
    "test:gpt-knowledge": "node --test scripts/test-gpt-knowledge.mjs",
    "test:gpt-skill": "node --test scripts/test-gpt-skill.mjs scripts/test-gpt-template-routing-integration.mjs scripts/test-gpt-template-form.mjs",
    "package": "node scripts/package.mjs",
    "migrate-old-pg": "node scripts/migrate-from-old-pg.mjs",
    "test:gpt-followup": "node --test scripts/test-gpt-followup.mjs scripts/test-client-record-defer.mjs",
    "test:chat-context": "node --test scripts/test-chat-context.mjs",
    "test:freight-estimate": "node --test scripts/test-freight-estimate.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^16.6.1",
    "linkedom": "^0.18.12",
    "pg": "^8.20.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
